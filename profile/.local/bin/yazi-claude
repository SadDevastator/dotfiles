#!/usr/bin/env zsh
# Open yazi; on exit, start Claude in the directory yazi was left in.
# Resumes the latest session there (claude -c) if one exists, else starts fresh.
tmp=$(mktemp -t yazi-cwd.XXXXXX)
yazi --cwd-file="$tmp" "${1:-$HOME}"
dir=$(<"$tmp"); rm -f "$tmp"
[[ -d $dir ]] || dir=$HOME
cd "$dir" || exit 1

# Claude stores sessions in ~/.claude/projects/<cwd with non-alnum chars -> '->/*.jsonl
proj="$HOME/.claude/projects/${PWD//[^a-zA-Z0-9]/-}"
sessions=($proj/*.jsonl(N))
if (( $#sessions )); then
  claude -c
else
  claude
fi
exec zsh
